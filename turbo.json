{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "HARLY_URL",
    "HARLY_DEV_ORIGINS",
    "NEXT_PUBLIC_APP_URL",
    "OPENHIRE_APP_NAME",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "STORAGE_PROVIDER",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_ENDPOINT",
    "S3_PUBLIC_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "AI_ENCRYPTION_KEY",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "HARLY_PUBLIC_URL",
    "STORAGE_UPLOAD_SECRET",
    "CRON_SECRET",
    "HARLY_SETUP_SECRET",
    "HARLY_INITIAL_ADMIN_EMAIL",
    "METRICS_TOKEN",
    "NATIVE_SIGN_SESSION_SECRET",
    "AUTOMATION_PREVIEW_SECRET",
    "HARLY_WEBHOOK_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "LINKEDIN_CLIENT_ID",
    "LINKEDIN_CLIENT_SECRET",
    "MICROSOFT_CLIENT_ID",
    "MICROSOFT_CLIENT_SECRET",
    "DOCUSEAL_URL",
    "DOCUSEAL_API_TOKEN",
    "DEMO_AI_API_KEY",
    "SAML_DOMAIN",
    "SAML_PROVIDER_ID",
    "SAML_IDP_METADATA_URL",
    "SAML_IDP_METADATA_FILE",
    "SAML_SP_PRIVATE_KEY",
    "RATE_LIMIT_STORE",
    "MCP_ALLOWED_ORIGINS",
    "LOG_LEVEL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
