NODE_ENV="development"

POSTGRES_USER="harly"
POSTGRES_PASSWORD="harly"
POSTGRES_DB="harly"
POSTGRES_PORT="5432"

DATABASE_URL="postgresql://harly:harly@localhost:5432/harly"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
HARLY_APP_NAME="Harly"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage (default: local disk, no config needed for dev)
# For production with Cloudflare R2 or AWS S3, set STORAGE_PROVIDER=s3
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 / MinIO (only needed if STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Email — Resend (optional, emails are skipped if not configured)
RESEND_API_KEY=""
EMAIL_FROM=""

# AI (optional) — required only to enable AI features (CV parsing, job-description
# generation). Master key that encrypts each workspace's provider API key at rest.
# Without it, AI stays off and the app falls back to the built-in heuristics.
# Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=""
