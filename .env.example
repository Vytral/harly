# ── App ──────────────────────────────────────────
NODE_ENV="development"
HARLY_URL="http://localhost:3000"
# Deprecated compatibility aliases; new installs should not need them.
NEXT_PUBLIC_APP_URL=""
HARLY_APP_NAME="Harly"
# Version the running instance reports (health check, OpenAPI, account menu).
# Compose installs set it from .env; leave unset in development.
HARLY_VERSION=""
# Dev only: extra origins (comma separated, e.g. "http://192.168.0.8:3000") that
# may open the dev server from another device on your network. Ignored in production.
HARLY_DEV_ORIGINS=""

# ── DocuSign eSignature (optional global fallback) ─────────────
# Workspace credentials configured in Settings take precedence.
# Use account-d for demo and account for production.
DOCUSIGN_BASE_URL="https://account-d.docusign.com"
DOCUSIGN_CLIENT_ID=""
DOCUSIGN_CLIENT_SECRET=""

# ── Database (PostgreSQL 16) ──────────────────────
POSTGRES_USER="harly"
POSTGRES_PASSWORD="replace-with-a-unique-random-password"
POSTGRES_DB="harly"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://harly:replace-with-a-unique-random-password@localhost:5432/harly"

# ── Auth (Better Auth) ────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
HARLY_SETUP_SECRET=""
HARLY_INITIAL_ADMIN_EMAIL="owner@example.com"
# Optional: company name used to prefill the workspace name on first run
HARLY_ORG_NAME=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft / Entra ID OAuth (optional). These credentials are also used by
# the Outlook integration when no workspace-specific Outlook credentials exist.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Storage ──────────────────────────────────────
# Default: local disk, no config needed for dev
# For production with Cloudflare R2 or AWS S3, set STORAGE_PROVIDER=s3
STORAGE_PROVIDER="local"
UPLOADS_DIR="uploads"
# Independent signing key for upload intents.
STORAGE_UPLOAD_SECRET=""

# S3 / Cloudflare R2 / MinIO (only needed if STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ── Email ─────────────────────────────────────────
# Resend (optional — emails are skipped if not configured). Workspaces can also
# connect their own mailbox or provider in Settings; these values are the
# installation-wide fallback.
RESEND_API_KEY=""
# Sender address, on a domain verified with your provider. Use your own domain;
# example.com is a reserved placeholder and cannot send real mail.
EMAIL_FROM="Harly <noreply@example.com>"
# Development only: print one-time sign-in links to the terminal when no email
# provider is configured. Ignored in production; never enable on a shared host.
AUTH_EMAIL_CONSOLE_FALLBACK="false"

# ── AI ────────────────────────────────────────────
# Master key that encrypts each workspace's AI provider API key at rest.
# Without it, AI features (CV parsing, job description generation, scoring)
# are disabled and the app falls back to built-in heuristics.
# Also used to encrypt outbound webhook signing secrets and email provider keys.
# Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=""
# Set to "1" to let workspaces use local or LAN model servers (Ollama, LM Studio,
# vLLM). Off by default because it allows requests to private addresses.
HARLY_ALLOW_LOCAL_LLM=""
# Model catalog (models.dev). HARLY_MODELS_DEV=0 uses only the bundled snapshot
# and never contacts the network (air-gapped hosts). The URL must be https.
HARLY_MODELS_DEV=""
HARLY_MODELS_DEV_TTL_HOURS="24"
HARLY_MODELS_DEV_URL=""
# Secret that signs automation previews. Defaults to BETTER_AUTH_SECRET.
AUTOMATION_PREVIEW_SECRET=""
# Emergency switch: "1" stops dispatching legacy (v1) automation workflows.
AUTOMATIONS_DISABLE_V1_DISPATCH=""

# ── Webhook retry cron ────────────────────────────
# Shared secret protecting the webhook retry dispatcher at
# /api/cron/webhooks/dispatch. Trigger that route on a schedule
# (Vercel Cron, system cron, or docker sidecar) with:
#   Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ── Logging ─────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace
# Default: info (in every environment)
LOG_LEVEL=info

# ── Resource limits (self-hosted Compose) ─────────
# Defaults target a 4 GB VPS. See https://docs.harly.dev/self-hosting/overview for the 2 GB profile.
HARLY_APP_MEMORY="1536m"
HARLY_POSTGRES_MEMORY="768m"
HARLY_MIGRATE_MEMORY="768m"
HARLY_SCHEDULER_MEMORY="256m"
HARLY_CADDY_MEMORY="256m"
HARLY_CACHE_MAX_MB="512"
HARLY_CACHE_MAX_AGE_DAYS="7"
HARLY_LOG_MAX_SIZE="10m"
HARLY_LOG_MAX_FILES="3"
# Host port the app listens on (127.0.0.1 only; Caddy or your proxy forwards to it).
HARLY_PORT="3000"
# Seconds since a scheduled job last ran before the health check calls the
# scheduler stale (minimum 60).
HARLY_SCHEDULER_STALE_AFTER_SECONDS="300"
# Seconds between polls of the host updater (harly updater run), 15-3600.
HARLY_UPDATER_INTERVAL="60"
# Milliseconds a migration may wait for a table lock; 0 disables the timeout.
HARLY_MIGRATION_LOCK_TIMEOUT_MS=""

# ── Database connection pools ─────────────────────
# Leave empty to use the defaults. See the configuration reference for sizing.
HARLY_DB_POOL_MAX=""
HARLY_DB_LOCK_POOL_MAX=""
HARLY_DB_MAILBOX_LOCK_POOL_MAX=""
# Seconds before an idle connection is closed (default 30), a new connection
# attempt fails (default 10), and a connection is recycled (default 1800).
HARLY_DB_IDLE_TIMEOUT=""
HARLY_DB_CONNECT_TIMEOUT=""
HARLY_DB_MAX_LIFETIME=""

# ── Rate limiting & Network ───────────────────────
# Rate limit backend: "memory" (default for single-instance) or "database" (for multi-replica HA).
RATE_LIMIT_STORE="memory"
# Comma-separated addresses of your own proxies/CDN edges that appear as hops in
# X-Forwarded-For; they are skipped when deriving the client IP.
TRUSTED_PROXY_IPS=""
# Allow outbound webhooks to reach loopback and private addresses. Leave false
# unless the installation is fully internal.
HARLY_ALLOW_PRIVATE_WEBHOOKS="false"
# RFC 8594 Sunset date (HTTP date) added, with Deprecation: true, to every /api/v1
# response. Empty adds no header.
API_V1_SUNSET=""

# ── Observability & Metrics ───────────────────────
# Bearer token required to scrape the Prometheus metrics endpoint at /metrics.
METRICS_TOKEN=""

# ── Slack App (OAuth) ─────────────────────────────
# Create a Slack App at https://api.slack.com/apps, then add these from
# Basic Information → App Credentials. Required for the Slack integration.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Days to keep Slack delivery history (30-730).
SLACK_DELIVERY_RETENTION_DAYS="90"

# ── Zoom (optional) ───────────────────────────────
# Zoom OAuth app for video interviews. ID and secret must be set together.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Optional URL that receives a JSON POST for each Harly event in workspaces
# with a connected Zoom account.
ZOOM_WEBHOOK_URL=""

# ── E-signature ───────────────────────────────────
# Self-hosted DocuSeal: optional installation-wide fallback. Workspace settings
# take precedence. With the bundled service use http://docuseal:3000.
DOCUSEAL_URL=""
DOCUSEAL_API_TOKEN=""
# Signs native-signing sessions. Defaults to AI_ENCRYPTION_KEY.
NATIVE_SIGN_SESSION_SECRET=""
# Days to keep signature evidence after completion (default 3650).
SIGNATURE_EVIDENCE_RETENTION_DAYS="3650"

# ── Microsoft Outlook (OAuth) ──────────────────────
# Register an app at https://portal.azure.com → App Registrations.
# Required scopes: Cal.ReadWrite Mail.Send offline_access User.Read
# Redirect URI: http://localhost:3000/api/integrations/outlook/callback
# Uses MICROSOFT_CLIENT_ID and MICROSOFT_CLIENT_SECRET declared above.

# ── Cloudflare Turnstile (optional anti-bot) ──────
# https://dash.cloudflare.com/turnstile — create a site + secret key pair.
# When set, the public apply form shows a Turnstile challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Public demo instance (optional; dedicated instance only) ─────────────
# Never enable on an installation with real workspace data. DEMO_MODE=true
# requires both Turnstile values above, serves a sample workspace as the public
# landing page (reset periodically), and signs each visitor into a private sandbox.
DEMO_MODE="false"
DEMO_LOGIN_EMAIL="demo@harly.dev"
# CDN that serves demo images in the demo seed (default https://cdn.harly.dev).
DEMO_CDN_URL=""
# Required when DEMO_MODE=true: the id of the demo template workspace. The
# scheduled reset wipes only this workspace and refuses to run without it.
DEMO_WORKSPACE_ID=""
# Operator guard for `pnpm db:seed:demo`, which DELETES every row of the target
# workspace. Set this to the workspace slug on the command line, for example
# `SEED_CONFIRM_WIPE=my-workspace pnpm db:seed:demo`, rather than in this file.
# Workspaces with more than 25 records outside their settings and stage
# definitions also need DEMO_WORKSPACE_ID to be pinned to the demo template.
SEED_CONFIRM_WIPE=""
# Owner email whose workspace `pnpm db:seed:demo` fills (default demo@harly.dev).
SEED_EMAIL=""
# Each demo visitor gets a private, disposable sandbox workspace. Lifetime in
# minutes (15-1440, default 240) and the most sandboxes alive at once (default 40).
DEMO_SANDBOX_TTL_MINUTES=""
DEMO_SANDBOX_MAX_ACTIVE=""
# Optional: platform OpenAI key so demo visitors can try Harly AI. Only read
# when DEMO_MODE=true. Use a Restricted key (Responses + Embeddings: Write) in
# its own OpenAI project with a hard monthly budget.
DEMO_AI_API_KEY=""
DEMO_AI_MODEL="gpt-6-luna"
# Instance-wide cap on demo AI requests per 24h (default 300).
DEMO_AI_DAILY_REQUEST_LIMIT=""

# ── Updates ───────────────────────────────────────
# Settings > Updates reads the public release manifest. Point it at a mirror,
# or set HARLY_DISABLE_UPDATE_CHECK=true on an air-gapped host to stop the
# check entirely. Both are optional.
HARLY_RELEASE_MANIFEST_URL=""
HARLY_DISABLE_UPDATE_CHECK=false

# ── MCP server (optional) ─────────────────────────
# Extra browser origins allowed to call /mcp, comma separated. Leave empty
# unless a browser-based MCP client (for example MCP Inspector) must connect.
# Native clients such as Claude and ChatGPT do not send an Origin.
MCP_ALLOWED_ORIGINS=""
