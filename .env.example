# ── App ──────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
HARLY_APP_NAME="Harly"

# ── Database (PostgreSQL 16) ──────────────────────
POSTGRES_USER="harly"
POSTGRES_PASSWORD="harly"
POSTGRES_DB="harly"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://harly:harly@localhost:5432/harly"

# ── Auth (Better Auth) ────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Storage ──────────────────────────────────────
# Default: local disk, no config needed for dev
# For production with Cloudflare R2 or AWS S3, set STORAGE_PROVIDER=s3
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 / MinIO (only needed if STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ── Email ─────────────────────────────────────────
# Resend (optional — emails are skipped if not configured)
RESEND_API_KEY=""
EMAIL_FROM="noreply@harly.com"

# ── AI ────────────────────────────────────────────
# Master key that encrypts each workspace's AI provider API key at rest.
# Without it, AI features (CV parsing, job description generation, scoring)
# are disabled and the app falls back to built-in heuristics.
# Also used to encrypt outbound webhook signing secrets and email provider keys.
# Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=""

# ── Webhook retry cron ────────────────────────────
# Shared secret protecting the webhook retry dispatcher at
# /api/cron/webhooks/dispatch. Trigger that route on a schedule
# (Vercel Cron, system cron, or docker sidecar) with:
#   Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ── Logging ─────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace
# Default: info in production, debug in development
LOG_LEVEL=info

# ── Rate limiting ─────────────────────────────────
# Optional: shared store for rate limiting across multiple instances.
# When unset, rate limiting is in-memory (correct for single instance / self-host).
REDIS_URL=""

# ── Slack App (OAuth) ─────────────────────────────
# Create a Slack App at https://api.slack.com/apps, then add these from
# Basic Information → App Credentials. Required for the Slack integration.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# ── Microsoft Outlook (OAuth) ──────────────────────
# Register an app at https://portal.azure.com → App Registrations.
# Required scopes: Cal.ReadWrite Mail.Send offline_access User.Read
# Redirect URI: http://localhost:3000/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Cloudflare Turnstile (optional anti-bot) ──────
# https://dash.cloudflare.com/turnstile — create a site + secret key pair.
# When set, the public apply form shows a Turnstile challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
