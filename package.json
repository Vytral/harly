{
  "name": "harly",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source applicant tracking system for modern teams.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/turbo/bin/turbo dev --filter=web",
    "dev:web": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/turbo/bin/turbo dev --filter=web",
    "build": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/turbo/bin/turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:validate": "pnpm --dir apps/docs validate",
    "docs:broken-links": "pnpm --dir apps/docs broken-links",
    "docs:a11y": "pnpm --dir apps/docs a11y",
    "generate:openapi": "pnpm --filter web generate:openapi",
    "clean": "rm -rf .next .turbo apps/*/.next apps/*/dist packages/*/dist tooling/*/dist",
    "db:up": "docker compose -f tooling/docker/compose.dev.yml up -d",
    "db:down": "docker compose -f tooling/docker/compose.dev.yml down",
    "db:generate": "pnpm --filter @harly/db db:generate",
    "db:migrate": "pnpm --filter @harly/db db:migrate",
    "db:verify-migrations": "pnpm --filter @harly/db db:verify-migrations",
    "db:studio": "pnpm --filter @harly/db db:studio",
    "db:push": "pnpm --filter @harly/db db:push",
    "db:seed": "pnpm --filter @harly/db db:seed",
    "db:seed:demo": "pnpm --filter @harly/db db:seed:demo"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@>=4.0.0-beta.10 <4.0.33": "4.0.33",
      "@babel/core": "7.29.6",
      "@simplewebauthn/server": "13.3.2",
      "@tiptap/core": "3.30.5",
      "@tiptap/extension-bubble-menu": "3.30.5",
      "@tiptap/extension-floating-menu": "3.30.5",
      "@xmldom/xmldom": "0.8.15",
      "axios": "1.18.0",
      "baseline-browser-mapping": "2.11.21",
      "browserslist": "4.28.9",
      "deepmerge-ts": "8.0.2",
      "drizzle-orm": "0.45.2",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "ip-address": "10.4.0",
      "nanoid@3": "3.3.18",
      "next>sharp": "0.35.4",
      "nodemailer": "9.1.1",
      "postcss": "8.5.25",
      "sanitize-html": "2.17.7",
      "tar": "7.5.19",
      "vite": "7.3.6",
      "vitest": "4.1.11"
    },
    "packageExtensions": {
      "drizzle-orm": {
        "dependencies": {
          "@opentelemetry/api": "^1.9.1"
        }
      }
    }
  }
}
